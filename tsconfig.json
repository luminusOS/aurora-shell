{
  "extends": "@tsconfig/strictest/tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext"],
    "types": [
      "@girs/gjs",
      "@girs/gnome-shell/ambient",
      "@girs/gnome-shell/extensions/global",
      "@girs/soup-3.0",
      "@girs/gjs/dom",
      "@girs/gweather-4.0",
      "@girs/rsvg-2.0"
    ],
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
